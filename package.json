{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vinext": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "test": "npm run build:vinext && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "supabase:seed": "node --experimental-strip-types scripts/seed-supabase.mjs",
    "dev:vinext": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "check:integrations": "node scripts/check-integrations.mjs",
    "test:commerce": "node --import tsx --test tests/test-commerce.mts",
    "check:easypost": "node scripts/check-easypost-test.mjs",
    "test:commerce:http": "node --test tests/test-commerce-http.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "source-map-js": "^1.2.4",
    "baseline-browser-mapping": "^2.11.39"
  },
  "type": "module"
}
